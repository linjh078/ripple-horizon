// ============================================================================
// RippleHorizon（观澜知远）— 数据库 Schema
// Prisma v5 + SQLite（SQLite 不支持 enum，使用 String + 应用层约束）
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 认证相关（Auth.js v5 兼容）
// ============================================================================

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           String    @default("USER")      // 权限：USER | HR | ADMIN
  identity       String    @default("STUDENT")   // 身份：STUDENT | ALUMNI | TEACHER | COUNSELOR | HR
  userNumber     String?   @unique               // 身份编号：A=校友, H=HR, T=教师, C=辅导员, U=在校生
  department     String?                         // 院系（必填，注册时选填）
  major          String?                         // 专业+班级，如"电子22-2"
  bio            String?                         // 留言板（给来访者的话）

  accounts       Account[]
  sessions       Session[]

  posts          Post[]
  comments       Comment[]
  lifeEvents     LifeEvent[]
  submittedSpots LifeSpot[]
  offlineEvents  OfflineEvent[]
  subjects       Subject[]
  materials      SubjectMaterial[]
  companies      Company[]
  positions      Position[]
  ratings        Rating[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 帖子
// ============================================================================

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   // STUDY_RESOURCES | ONLINE_COURSES | WEBSITES | EXAM_PREP | CAREER_SKILLS | SOFTWARE_TIPS
  imageUrls String?  // JSON 数组存储图片 URL
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// 评论
// ============================================================================

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// 个人时间轴事件
// ============================================================================

model LifeEvent {
  id        String   @id @default(uuid())
  title     String
  content   String
  imageUrls String?  // JSON 数组存储图片 URL
  eventDate DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// 校园周边
// ============================================================================

model LifeSpot {
  id            String   @id @default(uuid())
  name          String
  description   String
  category      String   // FOOD | SHOP | SERVICE | ENTERTAINMENT
  location      String?
  imageUrls     String?  // JSON 数组存储图片 URL
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================================
// 课程资源
// ============================================================================

model Subject {
  id          String            @id @default(uuid())
  name        String
  department  String?
  description String?
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  materials   SubjectMaterial[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model SubjectMaterial {
  id        String   @id @default(uuid())
  title     String
  content   String
  imageUrls String?  // JSON 数组存储图片 URL
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// 企业需求
// ============================================================================

model Company {
  id          String     @id @default(uuid())
  name        String
  industry    String?
  description String
  location    String?
  website     String?
  creatorId   String?
  creator     User?      @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  positions   Position[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Position {
  id           String   @id @default(uuid())
  title        String
  description  String
  requirements String?
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creatorId    String?
  creator      User?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================================
// 评级系统（五级评价）
// ============================================================================

model Rating {
  id         String   @id @default(uuid())
  targetId   String                     // 被评价对象的 ID
  targetType String                     // subject | post | spot | material
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     String                     // 夯 | 顶级 | 人上人 | NPC | 拉完了

  createdAt  DateTime @default(now())

  @@unique([targetId, targetType, userId])
}

// ============================================================================
// 线下活动
// ============================================================================

model OfflineEvent {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String?
  eventDate   DateTime
  category    String   @default("沙龙") // 沙龙 | 分享会 | 学习小组 | 其他
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
