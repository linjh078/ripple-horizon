# ============================================================================
# RippleHorizon（观澜知远）— 环境变量
# 复制此文件为 .env 并填入真实值
# ============================================================================

# 数据库连接（开发：SQLite，生产：PostgreSQL）
DATABASE_URL="file:./dev.db"
# 生产示例：DATABASE_URL="postgresql://user:password@host:5432/ripplehorizon"

# Auth.js 密钥（必需，生成方式：openssl rand -base64 32）
AUTH_SECRET="your-secret-here"

# 上传目录（可选，默认 public/uploads）
# UPLOAD_DIR="public/uploads"
